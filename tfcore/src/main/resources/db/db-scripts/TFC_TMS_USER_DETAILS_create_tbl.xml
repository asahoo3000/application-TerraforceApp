<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="1" author="Ashu">

        <createTable tableName="TFC_TMS_USER_DETAILS"
                     remarks="Table to store User Details">

            <column name="user_id" type="varchar(50)">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="user_name" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="password" type="varchar(50)">
                <constraints nullable="false" primaryKey="false"/>
            </column>

            <column name="is_active" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false" unique="true"/>
            </column>

        </createTable>

    </changeSet>
</databaseChangeLog>